# =============================================================================
# TURANT — Targeted Urgent Rapid Alert Notification Tool
# Environment configuration template
#
# Copy this file to `.env` and fill in the REAL values supplied by C-DOT.
#   * Never commit `.env`.
#   * Never ship fake/default credentials that "just work" — every connection
#     here must be a real C-DOT-provided value.
#   * Anything left empty means that module is operational but idle until the
#     corresponding real input arrives (see README.md "What real inputs are
#     required").
# =============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
APP_NAME=turant
# WARNING: debug endpoints expose internals. Enable ONLY in controlled
# environments (e.g. a C-DOT test/staging box) for integration testing.
ENABLE_DEBUG_ENDPOINTS=false

# ----------------------------------------------------------------------------
# Logging / audit trail
# ----------------------------------------------------------------------------
LOG_LEVEL=info
# When true, pipe logs through pino-pretty (human readable). JSON in prod.
LOG_PRETTY=false
# Absolute or relative path for the JSON-lines audit trail. Empty = stdout.
AUDIT_LOG_FILE=

# ----------------------------------------------------------------------------
# PostgreSQL / PostGIS — tower database + TURANT operational store
# ----------------------------------------------------------------------------
# Connection string to the real C-DOT PostGIS database.
DATABASE_URL=
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=10000

# ----------------------------------------------------------------------------
# Redis — subscriber prefetch cache + shared pipeline state
# ----------------------------------------------------------------------------
REDIS_URL=
# Prefix for all TURANT keys inside a shared Redis instance
REDIS_KEY_PREFIX=turant:

# ----------------------------------------------------------------------------
# Cell site / tower source (Requirement #2)
#   TOWER_SOURCE_MODE: postgis | http
# ----------------------------------------------------------------------------
TOWER_SOURCE_MODE=postgis

# --- PostGIS adapter: table + column mapping for the C-DOT tower table ------
TOWER_TABLE=cell_towers
TOWER_COL_ID=id
TOWER_COL_CELL_ID=cell_id
TOWER_COL_LAT=latitude
TOWER_COL_LNG=longitude
# Coverage model for tower footprint:
#   radius   -> point (lat/lng) + coverage_radius_m column
#   polygon  -> coverage_geom geometry column (Polygon/GeometryCollection)
TOWER_COVERAGE_MODEL=radius
TOWER_COL_COVERAGE_RADIUS_M=coverage_radius_m
TOWER_COL_COVERAGE_GEOM=coverage_geom
# Spatial reference ID of C-DOT geometry columns (4326 = WGS84 lon/lat)
TOWER_GEOM_SRID=4326

# --- HTTP adapter (used when TOWER_SOURCE_MODE=http) -------------------------
# Contract: GET {base}/towers-in-area?geojson=<Polygon>&srid=4326
#   Response: { "towers": [{ "id": "...", "cell_id": "...", ... }] }
# Awaiting the C-DOT API contract before this path is exercised.
TOWER_HTTP_BASE_URL=
TOWER_HTTP_TOKEN=
TOWER_HTTP_TIMEOUT_MS=10000

# Time budget for cell-site identification (ms). Requirement: seconds.
TOWER_MATCH_TIME_BUDGET_MS=5000
# Safety cap on towers returned per zone (not a load tuning knob).
TOWER_MATCH_LIMIT=100000

# ----------------------------------------------------------------------------
# CAP XML ingestion (Requirement #1)
#   Push mode : POST /api/v1/alerts/cap  (body = CAP XML, Content-Type: application/xml)
#   Poll mode : monitor a directory where the EWS drops CAP XML files
# ----------------------------------------------------------------------------
CAP_POLL_ENABLED=false
CAP_POLL_DIR=
CAP_POLL_INTERVAL_MS=5000
# Move processed files here (subfolders per day). Empty = delete after success.
CAP_POLL_ARCHIVE_DIR=
# Preferred CAP info language code (e.g. en-IN, hi-IN). First match wins.
CAP_PREFERRED_LANGUAGE=en-IN
# Maximum accepted CAP XML body size in bytes.
CAP_MAX_XML_BYTES=1048576

# ----------------------------------------------------------------------------
# Subscriber prefetch layer (Requirement #3)
#   Awaiting C-DOT subscriber database connection.
# ----------------------------------------------------------------------------
SUBSCRIBER_PREFETCH_ENABLED=false
SUBSCRIBER_PREFETCH_SYNC_INTERVAL_MS=900000
SUBSCRIBER_TABLE=subscribers
SUBSCRIBER_COL_MSISDN=msisdn
SUBSCRIBER_COL_TOWER_ID=tower_id
# live | prefetched  (see module 03 docs for tradeoffs)
SUBSCRIBER_LOOKUP_MODE=prefetched

# ----------------------------------------------------------------------------
# Geo-targeted subscriber matching (Requirement #4)
# ----------------------------------------------------------------------------
# Time budget for matching tens of thousands of tower IDs against the
# subscriber base (ms). Requirement: < 1 minute for ~50k towers.
MATCH_TIME_BUDGET_MS=60000

# ----------------------------------------------------------------------------
# SMSC / SMPP integration (Requirement #7)
#   Awaiting C-DOT SMSC sandbox credentials: host, port, system_id,
#   password, system_type.
# ----------------------------------------------------------------------------
SMPP_HOST=
SMPP_PORT=2775
SMPP_SYSTEM_ID=
SMPP_PASSWORD=
SMPP_SYSTEM_TYPE=
# transceiver | transmitter
SMPP_BIND_MODE=transceiver
# SMPP interface version (0x34 = SMPP 3.4)
SMPP_INTERFACE_VERSION=0x34
# Source address presented to the SMSC (registered SMS header)
SMPP_SRC_ADDR_TON=0
SMPP_SRC_ADDR_NPI=0
SMPP_SRC_ADDR=
# Destination address TON/NPI (1/1 = international MSISDN E.164)
SMPP_DEST_ADDR_TON=1
SMPP_DEST_ADDR_NPI=1
# 7bit (GSM-7, 160 chars) | ucs2 (max 70 chars)
SMS_DATA_CODING=7bit
# Message class + DLR bits (value of registered_delivery field; 0x01 = no DLR,
# 0x03 = SMS-delivery receipt). Module 11 drives this.
SMS_REGISTERED_DELIVERY=0x03
SMPP_RECONNECT_DELAY_MS=5000
# Per submit_sm command timeout (ms) before the attempt is failed.
SMPP_SUBMIT_TIMEOUT_MS=10000
# enqueue_link keepalive period (ms).
SMPP_ENQUIRE_LINK_PERIOD_MS=30000
# Max submit_sm PDUs in flight to the SMSC at once.
SMPP_SUBMIT_CONCURRENCY=25

# ----------------------------------------------------------------------------
# Delivery strategy (Requirement #10)
# ----------------------------------------------------------------------------
# single-attempt | retry
DELIVERY_STRATEGY=single-attempt
DELIVERY_RETRY_MAX=3
DELIVERY_RETRY_INTERVAL_MS=2000

# ----------------------------------------------------------------------------
# Expiry-aware submission control (Requirement #6)
# ----------------------------------------------------------------------------
# When true, the pipeline halts all new submissions the instant the alert's
# real expires timestamp is reached.
EXPIRY_HALT_SUBMISSION=true

# ----------------------------------------------------------------------------
# EWS completion callback (Requirement #12)
#   Awaiting the EWS callback URL + auth token from C-DOT.
# ----------------------------------------------------------------------------
EWS_CALLBACK_URL=
EWS_CALLBACK_TOKEN=
EWS_CALLBACK_TIMEOUT_MS=5000

# ----------------------------------------------------------------------------
# Parallel processing framework (Requirement #13)
# ----------------------------------------------------------------------------
# Number of worker_threads used for batch match + submit.
PARALLEL_WORKER_COUNT=4
# MSISDNs handed to the SMSC per submit iteration inside a worker.
SUBMIT_BATCH_SIZE=500

# ----------------------------------------------------------------------------
# Latency tracing (cross-cutting: t0..t5 per alert)
# ----------------------------------------------------------------------------
# Hours a per-alert trace record (t0..t5 + delivery percentiles) is retained.
TRACE_TTL_HOURS=24
