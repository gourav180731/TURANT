# TURANT Environment Configuration
# Copy this file to .env and fill in your values

# Spring Profile (development, staging, production)
SPRING_PROFILES_ACTIVE=production

# Database
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=turant
POSTGRES_USER=turant

# Redis
REDIS_PASSWORD=change_me_in_production

# SMPP Gateway (optional - leave empty to use simulation mode)
SMPP_HOST=
SMPP_PORT=2775
SMPP_SYSTEM_ID=
SMPP_PASSWORD=

# Simulation Mode (enabled/disabled)
# Set to 'disabled' when using real SMPP
SIMULATION_MODE=enabled

# Application
SERVER_PORT=8080
JAVA_OPTS=-Xmx1g -Xms512m

# Security — Item #2
# EWS API key for POST /api/v1/pipeline/trigger-by-cap and GET /status/towers/report
# Generate: openssl rand -hex 32
# Leave empty/disabled in local dev (filter pass-through), set in production
EWS_API_KEY=change_me_in_production_generate_64_hex
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# EWS Integration — Activity 7 (LOCAL / REMOTE)
# LOCAL: no external EWS dependency (dev/test). REMOTE: actual C-DOT EWS/VB.
# Real EWS integration is considered complete only after successful end-to-end
# communication with the authorized C-DOT EWS environment.
# Pending C-DOT EWS contract: baseUrl/path/method/auth are configurable.
EWS_MODE=local
# EWS_BASE_URL=https://<provided-by-C-DOT>
# EWS_LOCAL_URL=http://localhost:8080/api/v1/ews/local/receive  # controlled local EWS (dev only, blank in prod)
# EWS_API_KEY above is reused for remote auth (or use dedicated EWS_API_KEY)
# EWS_USERNAME= (if C-DOT uses basic auth)
# EWS_PASSWORD= (secret, never commit)
# EWS_PATH=/ews/callback
# EWS_METHOD=POST
# EWS_CONNECT_TIMEOUT=5s
# EWS_READ_TIMEOUT=15s
# EWS_SSL_ENABLED=false
# EWS_KEYSTORE= /path/to/keystore.p12
# EWS_KEYSTORE_PASSWORD=
# EWS_TRUSTSTORE= /path/to/truststore.p12
# EWS_TRUSTSTORE_PASSWORD=

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_TURANT=DEBUG
