{
  "name": "turant",
  "version": "0.1.0",
  "description": "TURANT — Targeted Urgent Rapid Alert Notification Tool. Location-based SMS dissemination for CAP early-warning alerts (C-DOT intern project).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed-telecom.ts",
    "seed:telecom-master": "tsx scripts/seed-telecom-master.ts",
    "benchmark:subscriber-matching": "tsx scripts/benchmark-subscriber-matching.ts",
    "benchmark:brute-force": "tsx scripts/brute-force-validation.ts",
    "benchmark:cell-access": "tsx scripts/benchmark-cell-access.ts",
    "build:cell-access": "tsx scripts/build-cell-subscriber-access.ts",
    "validate:telecom-data": "tsx scripts/validate-telecom-data.ts",
    "profile:matching": "tsx scripts/profile-subscriber-matching.ts"
  },
  "keywords": [
    "cap",
    "alerting",
    "sms",
    "smpp",
    "postgis",
    "redis",
    "disaster",
    "early-warning"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "ioredis": "^6.0.0",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0",
    "pino": "^10.3.1",
    "smpp": "^0.6.0-rc.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/pg-copy-streams": "^1.2.5",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
