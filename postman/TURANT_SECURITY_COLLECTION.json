    {
      "name": "S13 - Valid Request (Authorized, Signed, Valid CAP)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate unique capId so this valid test is never a replay duplicate",
              "pm.environment.set('newCapId', 'alert-' + pm.variables.replaceIn('{{$guid}}'));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('S13: Valid request accepted with 200 OK and alertId', function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    pm.expect(json.capIdentifier).to.be.a('string');",
              "    pm.expect(json.status).to.be.oneOf(['completed', 'processing', 'triggered', 'ingested']);",
              "    pm.environment.set('existingCapId', json.capIdentifier);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/xml" },
          { "key": "X-API-KEY", "value": "{{validApiKeyTspA}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<alert xmlns=\"urn:oasis:names:tc:emergency:cap:1.2\">\n    <identifier>{{newCapId}}</identifier>\n    <sender>india.ews@gov.in</sender>\n    <sent>2026-09-02T10:00:00Z</sent>\n    <status>Actual</status>\n    <msgType>Alert</msgType>\n    <scope>Public</scope>\n    <info>\n        <language>en-IN</language>\n        <category>Geo</category>\n        <event>Earthquake</event>\n        <urgency>Immediate</urgency>\n        <severity>Extreme</severity>\n        <certainty>Observed</certainty>\n        <headline>Major Earthquake Warning</headline>\n        <description>Strong seismic activity detected. Take immediate protective shelter.</description>\n        <area>\n            <areaDesc>Delhi NCR Region</areaDesc>\n            <circle>28.6139,77.2090 15</circle>\n        </area>\n    </info>\n</alert>"
        },
