        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><alert xmlns=\"urn:oasis:names:tc:emergency:cap:1.2\"><identifier>s03-nocert</identifier><sender>india.ews@gov.in</sender><sent>2026-09-02T10:00:00Z</sent><status>Actual</status><msgType>Alert</msgType><scope>Public</scope><info><event>Earthquake</event><urgency>Immediate</urgency><severity>Extreme</severity><certainty>Observed</certainty></info></alert>"
        },
