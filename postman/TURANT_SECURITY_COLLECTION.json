{
  "info": {
    "_postman_id": "turant-security-audit-matrix-v1",
    "name": "TURANT Production API Security Architecture — Test Matrix S01-S19",
    "description": "Comprehensive security test collection verifying all 10 defense-in-depth security layers of the TURANT Dissemination System.\n\nLayers Tested:\n1. Transport Security (TLS 1.3/HTTPS)\n2. Mutual TLS (mTLS & Anti-Spoofing)\n3. Digital CAP Signing (RSA/ECDSA SHA256)\n4. Authorization Engine (Default-Deny Policy)\n5. CAP Semantic & XXE Hardened Validation\n6. Durable Replay Protection (Atomic PostgreSQL PK)\n7. Per-Client Hashed Credentials (SHA-256)\n8. Network / IP Restrictions (CIDR allowlists)\n9. Token Bucket Rate Limiting (HTTP 429)\n10. Tamper-Evident Immutable Audit Hash Chain",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "S01 - No TLS / Plain HTTP Rejection",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// In production HTTPS-only profile, plain HTTP redirects or rejects",
              "pm.test('S01: Plain HTTP handled strictly or rejected', function () {",
              "    pm.expect([200, 301, 302, 400, 403, 426]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/xml" },
          { "key": "X-API-KEY", "value": "{{validApiKeyTspA}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><alert xmlns=\"urn:oasis:names:tc:emergency:cap:1.2\"><identifier>s01-notls-test</identifier><sender>india.ews@gov.in</sender><sent>2026-09-02T10:00:00Z</sent><status>Actual</status><msgType>Alert</msgType><scope>Public</scope><info><event>Cyclone</event><urgency>Immediate</urgency><severity>Extreme</severity><certainty>Observed</certainty></info></alert>"
        },
        "url": {
          "raw": "http://{{serverHost}}:{{serverPort}}/api/v1/pipeline/trigger-by-cap",
          "protocol": "http",
          "host": [ "{{serverHost}}" ],
          "port": "{{serverPort}}",
          "path": [ "api", "v1", "pipeline", "trigger-by-cap" ]
        },
        "description": "Tests transport layer requirement: in production TLS mode, unencrypted plain HTTP connections are rejected or upgraded."
      }
    },
    {
      "name": "S02 - Invalid TLS Certificate",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('S02: TLS Handshake / Certificate validation enforced', function () {",
              "    // Tested via TLS client engine or rejected handshake",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 403, 495, 496]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://{{serverHost}}:{{tlsPort}}/healthz",
          "protocol": "https",
          "host": [ "{{serverHost}}" ],
          "port": "{{tlsPort}}",
          "path": [ "healthz" ]
        },
        "description": "Tests TLS certificate authenticity. An untrusted or invalid server cert must cause client/proxy handshake termination."
      }
    },
    {
